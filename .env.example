# ===========================================================================
# FleetFlow — Root .env.example
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# All variables here are consumed by docker-compose.yml.
#
# POSTGRES_PASSWORD must not contain @ : / # ? % unless URL-encoded, because
# it is interpolated into DATABASE_URL.
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=fleetflow_db
POSTGRES_USER=fleetflow
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# Public frontend origin (CORS)
# Comma-separated list of browser origins that may call the API cross-origin.
# Same-origin Docker (browser → Nginx :80 → backend) does not need CORS.
# Example: https://fleetflow.example.com
# ---------------------------------------------------------------------------
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Frontend → Backend API URL (baked into the Vite bundle at image build time)
#
# Leave BOTH empty for Docker Compose / VPS so the browser uses same-origin
# URLs and Nginx proxies /auth, /trips, /ws, etc. to FastAPI.
#
# Do NOT set these to http://localhost:8000 on a remote server — localhost in
# the user's browser is the user's computer, not the VPS.
#
# Local Vite (not Docker) uses frontend/.env instead:
#   VITE_API_URL=http://127.0.0.1:8000
# ---------------------------------------------------------------------------
VITE_API_URL=
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# OpenRouteService (backend route planning only — do not expose in VITE_*)
# Get a free key at https://openrouteservice.org/dev/#/login
# ---------------------------------------------------------------------------
ORS_API_KEY=

# ---------------------------------------------------------------------------
# Nominatim (geocoding — OpenStreetMap, no key required)
# ---------------------------------------------------------------------------
NOMINATIM_USER_AGENT=FleetFlow/1.0 (fleet-logistics-app)

# ---------------------------------------------------------------------------
# Celery (compose overrides broker URLs to redis://redis:6379/0)
# ---------------------------------------------------------------------------
MAINTENANCE_ALERT_REMINDER_DAYS=7
MAINTENANCE_ALERT_CHECK_INTERVAL_MINUTES=60
