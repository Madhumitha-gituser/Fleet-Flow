# ===========================================================================
# FleetFlow — backend/.env.example
#
# Copy to backend/.env for local development.
# NEVER commit backend/.env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL or Neon)
# ---------------------------------------------------------------------------
# Local:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fleetflow_db
#
# Neon (Dashboard → Connection string → URI). Prefer the pooled host
# (*-pooler.*) for Render. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fleetflow_db

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Leave ENVIRONMENT=development so JWT_SECRET_KEY has a local fallback.
# Docker Compose sets ENVIRONMENT=production and requires JWT_SECRET_KEY.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# ---------------------------------------------------------------------------
# CORS (leave blank for local Vite — localhost origins are used by default)
# On Render, set these to your Vercel URL (no trailing slash):
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# ---------------------------------------------------------------------------
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# OpenRouteService (route planning)
# ---------------------------------------------------------------------------
ORS_API_KEY=your_openrouteservice_api_key_here

# ---------------------------------------------------------------------------
# Nominatim (geocoding — OpenStreetMap, no API key required)
# ---------------------------------------------------------------------------
NOMINATIM_USER_AGENT=FleetFlow/1.0 (fleet-logistics-app)

# ---------------------------------------------------------------------------
# Celery (background jobs)
# For local dev without Docker, "memory://" broker runs tasks eagerly.
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=false
MAINTENANCE_ALERT_REMINDER_DAYS=7
MAINTENANCE_ALERT_CHECK_INTERVAL_MINUTES=60