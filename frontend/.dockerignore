# ---------------------------------------------------------------------------
# frontend/.dockerignore
# Excludes files that must not be copied into the Docker build context.
# ---------------------------------------------------------------------------

# Node dependencies — Docker will run npm ci inside the container
node_modules/

# Production build output — Docker produces this during the build stage
dist/
dist-ssr/

# Git history — not needed in the image
.git/
.gitignore

# Local environment files containing real secrets
.env
.env.local
.env.*.local

# .env.example is safe to include (no real values)
# !.env.example  ← uncomment if you add one to the frontend

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor swap files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
