# Local Vite development — browser talks directly to the FastAPI process.
# Copy to frontend/.env (never commit frontend/.env).
#
# Docker/production builds leave this empty so the SPA uses same-origin
# requests; Nginx proxies /auth, /trips, /ws, etc. to the backend.
#
# Vercel: set VITE_API_URL in Project Settings → Environment Variables to your
# Render backend origin, then Redeploy (Vite bakes this in at build time).
# Example: VITE_API_URL=https://fleetflow-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Optional alias used by some Docker configs. Leave unset for local Vite.
# VITE_API_BASE_URL=http://127.0.0.1:8000
